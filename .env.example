# Copy to .env and adjust (the app reads real environment variables; .env is loaded by run.sh).
HOST=127.0.0.1
PORT=8000

# Optional API key. If set, the client must send "Authorization: Bearer <key>".
# Leave empty = no auth (local only!).
API_KEY=

# Path/name of the Claude CLI binary.
CLAUDE_BIN=claude

# --- Claude subscription auth (Docker) ---
# Preferred path: leave this EMPTY and log in inside the container once:
#   docker compose exec proxy claude /login
# Credentials persist in the mounted CLAUDE_CONFIG_DIR volume and auto-refresh.
#
# Optional convenience: a long-lived token from `claude setup-token` (official headless
# command, subscription-scoped, ToS-clean). If set, no interactive /login is needed.
CLAUDE_CODE_OAUTH_TOKEN=
# Where the CLI stores credentials/cache. In Docker this is set to the mounted volume
# path by docker-compose (/home/app/.claude); only override for a custom setup.
# CLAUDE_CONFIG_DIR=

# Default model when the client sends none/an unknown one: sonnet | opus | haiku | default
DEFAULT_MODEL=sonnet

# Timeouts. The binding limit is IDLE_TIMEOUT: seconds of SILENCE on the CLI stream. A turn may
# take as long as it likes as long as it keeps emitting — opus at xhigh effort thinks for minutes,
# and the CLI streams (empty) thinking_deltas the whole time. Measured worst-case silence is the
# prefill gap: ~10s at 1MB of context, otherwise <2s (guarded by cli.streams_continuously).
# REQUEST_TIMEOUT is only the backstop for a turn that never ends at all.
IDLE_TIMEOUT=60
REQUEST_TIMEOUT=1800

# Line buffer for the CLI streams, in bytes. asyncio's default is 64 KiB — too small: the deltas
# are tiny, but the final assistant/result event carries the WHOLE answer on ONE line, and a large
# multi-file patch blows past 64 KiB (~15k output tokens of JSON-escaped text is enough). This is a
# per-reader high-water mark, so the worst case is STREAM_LIMIT x POOL_MAX_PROCS of memory.
STREAM_LIMIT=16777216    # 16 MiB

# Stream a thinking progress line as `reasoning_content` while the model reasons (opus at xhigh
# can think for minutes before the first token — without this the client just sits there silent).
# The CLI redacts the actual reasoning text, so this is a progress indicator, not the model's
# thoughts: "Thinking… · 2.9k tokens", one line every THINKING_INTERVAL seconds. Clients APPEND
# these lines instead of replacing them, so keep the interval coarse — a short one turns a long
# reasoning phase into a wall of text.
STREAM_THINKING=1
THINKING_INTERVAL=10
# /v1/responses updates ONE summary line in place (clients replace summary[i] on .done) instead
# of appending, so a short interval is fine there — it reads like a live counter, not a log.
THINKING_INTERVAL_RESPONSES=1

# --- Perf knobs (empty = CLI default) ---
# Effort lowers compute/thinking (CLI default is "high"): low | medium | high | xhigh | max
# This is only the DEFAULT — clients may override per request via OpenAI `reasoning_effort`,
# OpenRouter `reasoning.effort`, OR a model-name suffix like `opus:max` (suffix wins).
# Note: per-request effort is part of the pool bucket key.
EFFORT=
# Picker entries with a pinned effort level, listed in /v1/models on top of the plain model
# IDs — so the model picker doubles as an effort selector (for UIs with no own effort control).
# Comma-separated "<model>:<level>"; empty disables them. Entries whose model or level does
# not exist are skipped with a warning.
# Deliberately a ladder of intents, not a cross product: no ':high' (that is the default and
# would duplicate the plain ID), and no small-model-at-high-effort (use the bigger model at
# its default instead — see https://claude.com/blog/claude-model-and-effort-level-in-claude-code).
EFFORT_PICKS=sonnet:low,opus:medium,opus:xhigh,opus:max
# Base system prompt. With REPLACE_SYSTEM_PROMPT=1 (default) it REPLACES the CLI's default
# (1.4k token on Opus, 6.6k on Sonnet/Haiku, ~460 with our base) via --system-prompt — the default
# describes a terminal/coding-agent environment with file & shell tools that do not exist here.
# Replacing removes the default's model identity and per-model knowledge-cutoff line, so the wrapper
# re-injects both per model (identity + cutoff from the model registry in app/config.py).
# system-prompts/chat.txt is a ready-made base for a chat frontend (open-webui etc.).
SYSTEM_PROMPT=
# Alternatively from a file (only used if SYSTEM_PROMPT is empty). DEFAULTS to the bundled
# system-prompts/chat.txt when unset — so replace mode works out of the box in every deployment
# (k8s, docker run, ...) without a per-env var. Set to "" to force the raw CLI default.
SYSTEM_PROMPT_FILE=system-prompts/chat.txt
# 1 (default): replace the CLI default with SYSTEM_PROMPT(+identity/cutoff). 0: touch nothing —
# no replace, no base — the CLI default stays as-is. Either way a leading client system message is
# ALWAYS appended on top via --append-system-prompt (it wins on conflict).
REPLACE_SYSTEM_PROMPT=1

# Incremental history caching: send the transcript as per-message content blocks with a
# cache_control breakpoint on the newest one. The append-stable history then caches
# incrementally (only the new turn is fresh input each turn) instead of being re-read whole.
# Verified over 50 turns: input cost/turn stays ~constant instead of growing with history. 1=on.
CACHE_HISTORY=1
CACHE_HISTORY_TTL=1h     # 1h | 5m  (must carry a ttl — the CLI rejects cache_control without one)

# --- Images (vision) ---
# Only inline (base64 / data-URI) images are accepted — remote URLs are deliberately NOT fetched
# (they would make the session non-deterministic; see README). Formats: png, jpeg, gif, webp.
# Oversized/excess images are dropped with a note in the history instead of failing the request.
MAX_IMAGE_MB=5
MAX_IMAGES=20

# --- Process pool (reuse) — saves spawn/init overhead per request ---
POOL_ENABLED=1
POOL_MAX_PROCS=8
POOL_IDLE_TTL=180        # seconds idle before an instance is reaped
POOL_MAX_USES=100        # recycle an instance after this many turns
POOL_REAP_INTERVAL=30
CLEAR_TIMEOUT=15         # /clear is instant; keep this short

# Metrics window (number of recent requests kept for latency percentiles).
METRICS_WINDOW=1000

# Debug/Logging
DEBUG=0
LOG_CLI_STDERR=0
